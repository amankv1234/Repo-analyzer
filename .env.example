# ==============================================================================
# RepoMentor Environment Configuration Template
# All variables defined here are validated at boot-time via Zod in packages/shared/src/env.ts
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# HTTP API Configuration (apps/api)
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Web Application Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16 + pgvector)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://repomentor:repomentor_dev_secret@localhost:5432/repomentor
POSTGRES_USER=repomentor
POSTGRES_PASSWORD=repomentor_dev_secret
POSTGRES_DB=repomentor
POSTGRES_PORT=5432

# Redis & BullMQ Queue Configuration (apps/worker & apps/api)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# LLM Provider Configuration
# Supported providers: "gemini" (FREE tier default) | "anthropic" | "mock"
LLM_PROVIDER=gemini

# Option A: Google Gemini (Free API Key from https://aistudio.google.com)
GEMINI_API_KEY=AIzaSyPlaceholder-replace-with-your-gemini-key
GEMINI_MODEL=gemini-1.5-flash

# Option B: Anthropic Claude (Production tier)
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-replace-with-real-key
ANTHROPIC_MODEL_ANALYSIS=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL_FAST=claude-3-5-haiku-20241022

# Embedding Provider Configuration
# Supported providers: "mock" (zero key development) | "voyage" | "local"
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=pa-placeholder-replace-with-real-voyage-key
VOYAGE_MODEL=voyage-code-2
EMBEDDING_DIMENSION=1536

# Ingestion Pipeline & Safety Limits
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_KB=1024
CLONE_DEPTH=1
TEMP_STORAGE_PATH=/tmp/repomentor

# Optional: GitHub Authentication / PAT for Private Repos
GITHUB_TOKEN=

