{
  "name": "repomentor",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Repository Onboarding Assistant",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mock": "cross-env LLM_PROVIDER=mock EMBEDDING_PROVIDER=mock turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "doctor": "tsx scripts/doctor.ts",
    "seed:mock": "tsx scripts/seed-mock.ts",
    "docker:up": "docker-compose up -d postgres redis",
    "docker:down": "docker-compose down",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.8",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "vitest": "^5.1.0"
  }
}

